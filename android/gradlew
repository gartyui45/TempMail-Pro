#!/bin/sh

# Gradle wrapper for TempMail Pro
# Uses the system Gradle installation

# Find Gradle
GRADLE=""
if command -v gradle > /dev/null 2>&1; then
    GRADLE="gradle"
elif [ -f "/usr/bin/gradle" ]; then
    GRADLE="/usr/bin/gradle"
elif [ -f "/usr/local/bin/gradle" ]; then
    GRADLE="/usr/local/bin/gradle"
elif [ -f "$HOME/gradle/bin/gradle" ]; then
    GRADLE="$HOME/gradle/bin/gradle"
fi

if [ -n "$GRADLE" ]; then
    exec $GRADLE "$@"
fi

# Fallback: try to use Java with a wrapper jar
WRAPPER_JAR="$(dirname "$0")/gradle/wrapper/gradle-wrapper.jar"
if [ -f "$WRAPPER_JAR" ]; then
    if [ -n "$JAVA_HOME" ]; then
        JAVA="$JAVA_HOME/bin/java"
    else
        JAVA="java"
    fi
    exec $JAVA -jar "$WRAPPER_JAR" "$@"
fi

echo "ERROR: Gradle not found. Install Gradle or use GitHub Actions."
exit 1
